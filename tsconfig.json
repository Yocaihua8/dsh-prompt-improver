{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "ESNext.Decorators"],
    "jsx": "react-jsx",
    "strict": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": ["src/index.ts", "src/host/**/*.ts", "src/shared/**/*.ts"]
}
